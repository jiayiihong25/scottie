# Copy to .env and fill in. .env is gitignored — never commit real values.
# In a Claude Code Routine these are supplied as environment variables on the
# environment instead, and real env vars take precedence over this file.

# Self-hosted OmniRoute gateway (Railway), OpenAI-compatible endpoint.
OMNIROUTE_BASE_URL=https://your-omniroute-instance.up.railway.app/v1
OMNIROUTE_API_KEY=
