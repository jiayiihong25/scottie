# Copy to .env and fill in the real value for OMNIROUTE_API_KEY.
# .env is gitignored — never commit real secrets.

# OmniRoute base URL (Railway deploy). Note: this instance's path is
# /api/v1, not the generic /v1 shown in OmniRoute's own docs — verify
# against your actual dashboard if you redeploy or change instances.
OMNIROUTE_BASE_URL=https://omniroute-production-e33a.up.railway.app/api/v1

# Generate this in the OmniRoute dashboard (Settings -> API Keys) once
# dashboard login is working. Never commit the real value.
OMNIROUTE_API_KEY=
